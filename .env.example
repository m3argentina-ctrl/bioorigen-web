# PostgreSQL — connection string de Neon o Supabase
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# MercadoPago — credenciales de https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública del sitio (para callbacks de pago)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Telegram — avisos de flota (alarma / sin conexión)
#   BOT_TOKEN: lo da @BotFather al crear el bot.
#   ADMIN_CHAT_ID: chat/grupo de Bio Origen (escribile al bot y mirá
#     https://api.telegram.org/bot<TOKEN>/getUpdates para ver el chat.id).
#   El chat de cada cliente se guarda aparte en Cliente.telegramChatId.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Watchdog — secreto compartido entre el cron de GitHub Actions y el endpoint
# /api/cron/watchdog. Cargar el MISMO valor en Vercel (env) y en el secret
# CRON_SECRET del repo de GitHub.
CRON_SECRET=""

# SMTP — envío de emails (formulario de contacto y alertas de flota por email).
#   Si no se configura, el envío de email queda deshabilitado (no rompe nada:
#   las alertas siguen saliendo por Telegram).
#   SECURE=true para puerto 465 (SSL); false para 587 (STARTTLS).
#
#   Con un relay tipo Brevo (recomendado, no depende del hosting):
#     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#     SMTP_USER=<login que muestra Brevo>   SMTP_PASS=<SMTP key de Brevo>
#     MAIL_FROM=alertas@bioorigen.com.ar    (remitente verificado del dominio)
#
#   MAIL_FROM: dirección remitente ("from"). Si se omite, se usa SMTP_USER (sirve
#   cuando el login SMTP y la casilla son la misma, p. ej. una casilla propia).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
