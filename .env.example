# PostgreSQL — connection string de Neon o Supabase
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# MercadoPago — credenciales de https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública del sitio (para callbacks de pago)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Telegram — avisos de flota (alarma / sin conexión)
#   BOT_TOKEN: lo da @BotFather al crear el bot.
#   ADMIN_CHAT_ID: chat/grupo de Bio Origen (escribile al bot y mirá
#     https://api.telegram.org/bot<TOKEN>/getUpdates para ver el chat.id).
#   El chat de cada cliente se guarda aparte en Cliente.telegramChatId.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Watchdog — secreto compartido entre el cron de GitHub Actions y el endpoint
# /api/cron/watchdog. Cargar el MISMO valor en Vercel (env) y en el secret
# CRON_SECRET del repo de GitHub.
CRON_SECRET=""
